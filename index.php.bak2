<?php
require_once __DIR__ . '/config/database.php';

$page   = $_GET['page'] ?? 'home';
$total  = 0;
$daftar = [];
try {
    $total = (int)$pdo->query("SELECT COUNT(*) FROM pegawai_terenkripsi")->fetchColumn();
    if ($page === 'data') {
        $daftar = $pdo->query("SELECT nama, jabatan FROM pegawai_publik ORDER BY nama ASC")->fetchAll();
    }
} catch (Exception $e) {
    $daftar = [];
}
?>
